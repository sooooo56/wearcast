# 이 파일이 하는 일: 서버리스 함수(/api/explain)에 필요한 환경변수 예시. 실제 값은 .env.local에 넣는다 (git에 올리지 않음).
# Vercel 배포 시에는 프로젝트 설정 > Environment Variables에 같은 이름으로 넣는다.

# anthropic(기본) | mock(키 없이 흐름만 확인하는 로컬 테스트용)
LLM_PROVIDER=anthropic

# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=

# 모델 이름 (코드에 넣지 않고 여기서 바꾼다)
LLM_MODEL=claude-opus-5-5

# 생각 깊이: 짧은 문장이라 low로 충분 (low | medium | high)
LLM_EFFORT=low
